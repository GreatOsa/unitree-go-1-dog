<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera">

  <xacro:macro name="camera" params="parent">

    <!-- Camera link -->
    <link name="camera_link">
      <visual>
        <origin xyz="0 -0.01 0.01" rpy="0.7854 0 0"/>
        <geometry>
          <mesh filename="package://unitreedog_description/meshes/depthCamera.dae" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="base_color">
          <color rgba="0.9 0.29 0.0 1"/>
        </material>
      </visual>


      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <!-- approx sphere inertia (r~0.03) -->
        <inertia
          ixx="0.000054" ixy="0.0" ixz="0.0"
          iyy="0.000054" iyz="0.0"
          izz="0.000054"/>
      </inertial>

    </link>

    <!-- Camera sensor -->
    <joint name="camera_joint" type="fixed">
      <!-- <parent link="base_link"/> -->
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="0.288 0 0.047" rpy="0 0 0"/>
      <!-- <origin xyz="0.3 0 0" rpy="0 0 0"/> -->
    </joint>

    <link name="ultraSound">
      <visual>
        <origin xyz="0 0 0.02" rpy="-0.7854 0 0"/>
        <geometry>
          <mesh filename="package://unitreedog_description/meshes/ultraSound.dae" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="base_color">
          <color rgba="0.9 0.29 0.0 1"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <!-- approx sphere inertia (r~0.03) -->
        <inertia
          ixx="0.000054" ixy="0.0" ixz="0.0"
          iyy="0.000054" iyz="0.0"
          izz="0.000054"/>
      </inertial>
    </link>

    <joint name="base_to_ultraSound" type="fixed">
      <parent link="camera_link"/>
      <child link="ultraSound"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- <limit lower="0.0" upper="0.3" effort="10" velocity="0.5"/> -->
    </joint>


    <gazebo reference="camera_link">
      <sensor type="camera" name="camera_sensor">
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov> <!-- 60 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="camera" filename="libgz-sim-camera-system.so">
          <ros>
            <namespace>/camera</namespace>
            <remapping>image_raw:=image_raw</remapping>
          </ros>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>


  </xacro:macro>
</robot>