<?xml version="1.0"?>
<robot name="UnitreeDog" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- BASE LINK -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <mesh filename="package://unitreedog_description/meshes/trunk.dae"/>
      </geometry>
      <material name="brown">
        <color rgba="0.6 0.3 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <box size="0.588 0.22 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="5.5"/>
      <inertia ixx="0.02878" iyy="0.16506" izz="0.18064"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>


   <!-- Camera -->
  <xacro:include filename="$(find unitreedog_description)/urdf/camera.urdf.xacro"/>
  <xacro:camera parent="base_link"/>


  <!-- BACK RIGHT HIP -->
  <link name="back_hip_right">
    <visual>
      <origin rpy="0 3.1416 0"/>
      <geometry>
        <mesh filename="package://unitreedog_description/meshes/hip.dae"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.125"/>
      <inertia ixx="0.00003" iyy="0.00005" izz="0.00005"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_back_hip_right" type="revolute">
    <parent link="base_link"/>
    <child link="back_hip_right"/>
    <axis xyz="1 0 0"/>
    <origin xyz="-0.19 -0.05 0.06"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- BACK LEFT HIP -->
  <link name="back_hip_left">
    <visual>
      <origin rpy="0 3.1416 0"/>
      <geometry>
        <mesh filename="package://unitreedog_description/meshes/hip.dae"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.125"/>
      <inertia ixx="0.00003" iyy="0.00005" izz="0.00005"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_back_hip_left" type="revolute">
    <parent link="base_link"/>
    <child link="back_hip_left"/>
    <axis xyz="1 0 0"/>
    <origin xyz="-0.19 0.05 0.06"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- FRONT RIGHT HIP -->
  <link name="front_hip_right">
    <visual>
      <geometry>
        <mesh filename="package://unitreedog_description/meshes/hip.dae"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.125"/>
      <inertia ixx="0.00003" iyy="0.00005" izz="0.00005"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_front_hip_right" type="revolute">
    <parent link="base_link"/>
    <child link="front_hip_right"/>
    <axis xyz="1 0 0"/>
    <origin xyz="0.19 -0.05 0.06"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

   

  <!-- FRONT LEFT HIP -->
  <link name="front_hip_left">
    <visual>
      <geometry>
        <mesh filename="package://unitreedog_description/meshes/hip.dae"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.125"/>
      <inertia ixx="0.00003" iyy="0.00005" izz="0.00005"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_front_hip_left" type="revolute">
    <parent link="base_link"/>
    <child link="front_hip_left"/>
    <axis xyz="1 0 0"/>
    <origin xyz="0.19 0.05 0.06"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- LEGS -->
  <xacro:include filename="$(find unitreedog_description)/urdf/legs.urdf.xacro"/>
  <xacro:legs
    front_hip_right="front_hip_right"
    front_hip_left="front_hip_left"
    back_hip_right="back_hip_right"
    back_hip_left="back_hip_left"/>

  <!-- GAZEBO FRICTION -->
  <gazebo reference="base_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="front_calf_right"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="front_calf_left"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="back_calf_right"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="back_calf_left"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>

  <!-- ROS2 CONTROL -->
  <ros2_control name="UnitreeSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="base_to_back_hip_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_to_back_hip_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_to_front_hip_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_to_front_hip_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_to_right_front_leg">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_front_leg_to_calf">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_to_left_front_leg">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_front_leg_to_calf">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="hip_to_right_back_leg">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_back_leg_to_calf">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="hip_to_left_back_leg">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_back_leg_to_calf">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- GAZEBO PLUGIN -->
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin"
            filename="libgz_ros2_control-system.so">
      <parameters>$(find unitreedog_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>